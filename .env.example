# tensor-workbench-ryan-vo Environment Configuration
# Copy to .env and fill in values. Never commit .env with real secrets.

# Application
APP_NAME=tensor-workbench-ryan-vo
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
DATABASE_URL=sqlite+aiosqlite:///./data/tensor-workbench.db
SECRET_KEY=change-me-in-production-use-strong-random
API_PREFIX=/api

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME=tensor-workbench

# Keycloak (OIDC)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=tensor-workbench
KEYCLOAK_CLIENT_ID=tensor-workbench
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# OIDC Discovery (auto-configured from Keycloak)
OIDC_ISSUER=http://localhost:8080/realms/tensor-workbench
OIDC_AUTHORIZATION_ENDPOINT=http://localhost:8080/realms/tensor-workbench/protocol/openid-connect/auth
OIDC_TOKEN_ENDPOINT=http://localhost:8080/realms/tensor-workbench/protocol/openid-connect/token
OIDC_JWKS_URI=http://localhost:8080/realms/tensor-workbench/protocol/openid-connect/certs
OIDC_USERINFO_ENDPOINT=http://localhost:8080/realms/tensor-workbench/protocol/openid-connect/userinfo
OIDC_LOGOUT_ENDPOINT=http://localhost:8080/realms/tensor-workbench/protocol/openid-connect/logout

# Apple Developer (for future App Store Connect integration)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APP_STORE_CONNECT_ISSUER_ID=

# LLM (optional, for AI-assisted features)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# SwiftPM / Build
SWIFT_PATH=swift
SWIFTPM_CONFIG_DIR=.swiftpm
WORKSPACE_ROOT=/workspace
SDK_INSTALL_DIR=/opt/swift-sdks

# Device / USB
USBMUXD_SOCKET=/var/run/usbmuxd
LIBIMOBILEDEVICE_PATH=

# Demo mode (localhost only, refuses in production)
DEMO_MODE=true
DEMO_USER_EMAIL=demo@tensor-workbench.local
DEMO_USER_ROLE=admin

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json